MONGO_URI=mongodb://127.0.0.1:27017/mental_demo
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
# In production, use a mounted persistent directory (avatars are public).
UPLOAD_DIR=./uploads
# Optional. Without a key the chatbot uses explicitly limited fallback responses.
GROQ_API_KEY=
# Optional separate service; the emotion model/server is not included.
EMOTION_API_URL=http://127.0.0.1:8000
# Used only by seed:demo. Choose a unique password; no shared credentials are published.
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=
