{
  "info": {
    "name": "Mental Health API",
    "_postman_id": "mental-health-grad-2026",
    "description": "Complete API collection for the Mental Health graduation project.\n\n**Base URL:** `http://localhost:3000`\n\n**Auth:** Most protected routes use Bearer JWT. After login, copy the `token` from the response and set the `token` collection variable.\n\n**Roles:**\n- `user` — standard authenticated user\n- `admin` — admin-only endpoints (use `adminToken` variable)\n\n**Variables to set before testing:**\n- `baseUrl` → `http://localhost:3000`\n- `token` → JWT from `/login`\n- `adminToken` → JWT from admin `/login`\n- `petId` → ObjectId of a pet\n- `articleId` → ObjectId of an article\n- `userId` → ObjectId of a user (admin operations)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:3000", "type": "string" },
    { "key": "token",       "value": "",                      "type": "string", "description": "JWT for regular user — paste from /login response" },
    { "key": "adminToken",  "value": "",                      "type": "string", "description": "JWT for admin user — paste from /login response" },
    { "key": "petId",       "value": "",                      "type": "string", "description": "MongoDB ObjectId of a pet" },
    { "key": "articleId",   "value": "",                      "type": "string", "description": "MongoDB ObjectId of an article" },
    { "key": "userId",      "value": "",                      "type": "string", "description": "MongoDB ObjectId of a user (admin ops)" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Registration, login, and password reset — no authentication required.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Ali\",\n  \"email\": \"ahmed@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create a new user account.\n\n**Required body fields:**\n- `name` (string)\n- `email` (string, unique)\n- `password` (string, min 6 chars)"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"User registered successfully\",\n  \"user\": {\n    \"id\": \"664f1a2b3c4d5e6f7a8b9c0d\",\n    \"name\": \"Ahmed Ali\",\n    \"email\": \"ahmed@example.com\",\n    \"role\": \"user\"\n  }\n}"
            },
            {
              "name": "400 Email Already Registered",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Email already registered\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token saved to collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Authenticate a user and receive a JWT (valid 12 hours).\n\nThe test script automatically saves the returned `token` to the `token` collection variable."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Login successful\",\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"664f1a2b3c4d5e6f7a8b9c0d\",\n    \"name\": \"Ahmed Ali\",\n    \"email\": \"ahmed@example.com\",\n    \"role\": \"user\"\n  }\n}"
            },
            {
              "name": "400 Invalid Credentials",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Invalid email or password\"\n}"
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/forgot-password", "host": ["{{baseUrl}}"], "path": ["forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Request a 6-character hex reset token. In production this would be emailed; in dev it is returned directly.\n\nToken expires in **15 minutes**."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Reset token generated.\",\n  \"resetToken\": \"A3F9C1\",\n  \"note\": \"Expires in 15 minutes\"\n}"
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/reset-password", "host": ["{{baseUrl}}"], "path": ["reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@example.com\",\n  \"resetToken\": \"A3F9C1\",\n  \"newPassword\": \"newSecret456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Reset a user's password using the token from `/forgot-password`.\n\n**Required body fields:**\n- `email`\n- `resetToken` (case-insensitive)\n- `newPassword` (min 6 chars)"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Password reset successfully ✅\"\n}"
            },
            {
              "name": "400 Invalid Token",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Invalid reset token\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "User Profile & Wishlist",
      "description": "Profile management and pet wishlist. All endpoints require a valid Bearer token (inherit from collection).",
      "auth": { "type": "inherit" },
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] },
            "description": "Retrieve the authenticated user's profile."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"user\": {\n    \"_id\": \"664f1a2b3c4d5e6f7a8b9c0d\",\n    \"name\": \"Ahmed Ali\",\n    \"email\": \"ahmed@example.com\",\n    \"role\": \"user\",\n    \"wishlist\": [],\n    \"createdAt\": \"2026-04-21T10:00:00.000Z\"\n  }\n}"
            },
            {
              "name": "401 No Token",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"No token provided\"\n}"
            }
          ]
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Mohamed\",\n  \"currentPassword\": \"secret123\",\n  \"newPassword\": \"newSecret456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Update the authenticated user's name and/or password.\n\n**Optional body fields:**\n- `name` — new display name\n- `currentPassword` + `newPassword` — to change password (both required together)"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Profile updated successfully\",\n  \"user\": {\n    \"_id\": \"664f1a2b3c4d5e6f7a8b9c0d\",\n    \"name\": \"Ahmed Mohamed\",\n    \"email\": \"ahmed@example.com\",\n    \"role\": \"user\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Wishlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/wishlist", "host": ["{{baseUrl}}"], "path": ["wishlist"] },
            "description": "Retrieve the authenticated user's pet wishlist (populated pet objects)."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"wishlist\": [\n    {\n      \"_id\": \"665a1b2c3d4e5f6a7b8c9d0e\",\n      \"name\": \"Buddy\",\n      \"type\": \"Dog\",\n      \"personality\": \"Calm\",\n      \"description\": \"A gentle golden retriever.\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Add Pet to Wishlist",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{petId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "{{petId}}"]
            },
            "description": "Add a pet to the authenticated user's wishlist.\n\n**Path param:** `petId` — MongoDB ObjectId of the pet"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Pet added to wishlist ✅\",\n  \"wishlist\": [\"665a1b2c3d4e5f6a7b8c9d0e\"]\n}"
            }
          ]
        },
        {
          "name": "Remove Pet from Wishlist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{petId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "{{petId}}"]
            },
            "description": "Remove a pet from the authenticated user's wishlist.\n\n**Path param:** `petId` — MongoDB ObjectId of the pet"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Pet removed from wishlist ✅\",\n  \"wishlist\": []\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Pets",
      "description": "Pet catalog. `GET /pets` is public. `POST` and `DELETE` require admin Bearer token.",
      "item": [
        {
          "name": "Get All Pets",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pets?type=Dog&personality=Calm",
              "host": ["{{baseUrl}}"],
              "path": ["pets"],
              "query": [
                { "key": "type",        "value": "Dog",  "description": "Filter by pet type (e.g. Dog, Cat, Bird)" },
                { "key": "personality", "value": "Calm", "description": "Filter by personality label" }
              ]
            },
            "description": "List all pets. Both query parameters are **optional**.\n\n**Query params:**\n- `type` — e.g. `Dog`, `Cat`, `Bird`\n- `personality` — e.g. `Calm`, `Social`, `Anxious`"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"_id\": \"665a1b2c3d4e5f6a7b8c9d0e\",\n    \"name\": \"Buddy\",\n    \"type\": \"Dog\",\n    \"personality\": \"Calm\",\n    \"description\": \"A gentle golden retriever.\",\n    \"createdAt\": \"2026-04-20T08:00:00.000Z\"\n  },\n  {\n    \"_id\": \"665a1b2c3d4e5f6a7b8c9d1f\",\n    \"name\": \"Whiskers\",\n    \"type\": \"Cat\",\n    \"personality\": \"Social\",\n    \"description\": \"A playful tabby cat.\",\n    \"createdAt\": \"2026-04-20T09:00:00.000Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Create Pet  [Admin]",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Buddy\",\n  \"type\": \"Dog\",\n  \"personality\": \"Calm\",\n  \"description\": \"A gentle golden retriever good for anxious owners.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "**Admin only.** Create a new pet in the catalog.\n\n**Required body fields:**\n- `name` (string)\n\n**Optional:**\n- `type` — e.g. Dog, Cat, Bird\n- `personality` — e.g. Calm, Social, Anxious\n- `description`"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"_id\": \"665a1b2c3d4e5f6a7b8c9d0e\",\n  \"name\": \"Buddy\",\n  \"type\": \"Dog\",\n  \"personality\": \"Calm\",\n  \"description\": \"A gentle golden retriever good for anxious owners.\",\n  \"createdAt\": \"2026-04-21T10:00:00.000Z\",\n  \"updatedAt\": \"2026-04-21T10:00:00.000Z\"\n}"
            },
            {
              "name": "403 Forbidden (not admin)",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Access denied. Admins only.\"\n}"
            }
          ]
        },
        {
          "name": "Delete Pet  [Admin]",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pets/{{petId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pets", "{{petId}}"]
            },
            "description": "**Admin only.** Permanently delete a pet by its MongoDB ObjectId.\n\n**Path param:** `petId`"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Pet deleted successfully\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Articles",
      "description": "Mental health articles. `GET /articles` is public. Create / Update / Delete require admin.",
      "item": [
        {
          "name": "Get All Articles",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/articles?search=anxiety&category=Wellness",
              "host": ["{{baseUrl}}"],
              "path": ["articles"],
              "query": [
                { "key": "search",   "value": "anxiety", "description": "Full-text search in title/content" },
                { "key": "category", "value": "Wellness", "description": "Filter by article category" }
              ]
            },
            "description": "List all articles. Both query parameters are **optional**.\n\n**Query params:**\n- `search` — keyword search\n- `category` — e.g. `Wellness`, `Therapy`, `Meditation`"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"_id\": \"664c0a1b2c3d4e5f6a7b8c9d\",\n    \"title\": \"Managing Anxiety at Work\",\n    \"content\": \"Anxiety in the workplace is common...\",\n    \"category\": \"Wellness\",\n    \"createdAt\": \"2026-04-19T12:00:00.000Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Create Article  [Admin]",
          "request": {
            "auth": {
