            "url": {
              "raw": "{{baseUrl}}/articles/{{articleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["articles", "{{articleId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Managing Anxiety at Work — Updated\",\n  \"content\": \"Updated content with new research...\",\n  \"category\": \"Therapy\"\n}",
