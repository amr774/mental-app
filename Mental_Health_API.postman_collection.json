          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"_id\": \"664c0a1b2c3d4e5f6a7b8c9d\",\n  \"title\": \"Managing Anxiety at Work — Updated\",\n  \"content\": \"Updated content with new research...\",\n  \"category\": \"Therapy\",\n  \"updatedAt\": \"2026-04-21T11:00:00.000Z\"\n}"
