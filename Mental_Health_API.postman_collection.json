      ]
    },
    {
      "name": "Personality Test",
      "description": "Submit answers and view results. Requires user Bearer token (inherited from collection).",
      "auth": { "type": "inherit" },
      "item": [
        {
          "name": "Take Personality Test",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/personality-test", "host": ["{{baseUrl}}"], "path": ["personality-test"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [2, 3, 1, 4, 2]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Submit an array of numeric answers to the personality quiz.\n\n**Scoring logic:**\n- Sum of answers `< 10` → `\"Calm\"`\n- Sum `10–19` → `\"Social\"`\n- Sum `≥ 20` → `\"Anxious\"`\n\n**Required body:**\n- `answers` — non-empty array of numbers\n\n**Example sums:**\n- `[2,3,1,4,2]` → sum 12 → `Social`\n- `[1,1,1,1,1]` → sum 5 → `Calm`\n- `[5,5,5,5,5]` → sum 25 → `Anxious`"
          },
          "response": [
            {
              "name": "200 OK — Social",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Test completed\",\n  \"result\": \"Social\",\n  \"testId\": \"664e9f1a2b3c4d5e6f7a8b9c\"\n}"
            },
            {
              "name": "200 OK — Calm",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Test completed\",\n  \"result\": \"Calm\",\n  \"testId\": \"664e9f1a2b3c4d5e6f7a8b9d\"\n}"
            },
            {
              "name": "400 Missing Answers",
              "status": "Bad Request",
              "code": 400,
