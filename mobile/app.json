{
  "expo": {
    "name": "Mindful",
    "slug": "mindful-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B9FD4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindful.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6B9FD4"
      },
      "package": "com.mindful.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mindful to access your photos to set your profile picture.",
          "cameraPermission": "Allow Mindful to access your camera."
        }
      ],
      "expo-font",
      "expo-av",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "mindful-app-project-id"
      }
    },
    "scheme": "mindful"
  }
}
